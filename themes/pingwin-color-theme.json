  "tokenColors": [
    {
      "name": "Default — the grey ramp carries most of the code",
      "scope": [
        "source",
        "meta.embedded",
        "meta.brace",
        "text"
      ],
      "settings": { "foreground": "#d7e0e7" }
    },
    {
      "name": "Comment — faint and italic so it recedes completely",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block",
        "comment.line",
        "string.comment"
      ],
      "settings": { "foreground": "#55666f", "fontStyle": "italic" }
    },
    {
      "name": "Comment keyword — TODO, FIXME, @param",
      "scope": [
        "keyword.codetag",
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc",
        "comment keyword.other"
      ],
      "settings": { "foreground": "#71838f", "fontStyle": "italic" }
    },
    {
      "name": "String — ok-green, pingwin's 'this went through' colour",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "meta.attribute-selector string",
        "support.constant.property-value"
      ],
      "settings": { "foreground": "#57c78a" }
    },
    {
      "name": "String interpolation and escapes — amber, because they are code",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.template.expression",
        "string.regexp punctuation.definition.group"
      ],
      "settings": { "foreground": "#f2a33c" }
    },
    {
      "name": "Regexp body",
      "scope": [
        "string.regexp",
        "string.regexp constant.character.escape"
      ],
      "settings": { "foreground": "#e0b84c" }
    },
    {
      "name": "Number, boolean, null and language constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "keyword.other.unit",
        "support.constant.math"
      ],
      "settings": { "foreground": "#f2a33c" }
    },
    {
      "name": "User constant — SCREAMING_CASE and enum members",
      "scope": [
        "constant.other",
        "constant.character",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": { "foreground": "#f2a33c" }
    },
    {
      "name": "Keyword — the only chrome-amber in the syntax, like pingwin's accent",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "keyword.operator.logical.python",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language.this",
        "variable.language.super",
        "variable.language.self"
      ],
      "settings": { "foreground": "#f2a33c" }
    },
    {
      "name": "Operator and punctuation — structural, so they sit back",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.ternary"
      ],
      "settings": { "foreground": "#71838f" }
    },
    {
      "name": "Punctuation, braces, separators",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.section",
        "meta.delimiter"
      ],
      "settings": { "foreground": "#55666f" }
    },
    {
      "name": "Function and method — warn-yellow, the second voice",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.method",
        "meta.method entity.name.function"
      ],
      "settings": { "foreground": "#e0b84c" }
    },
    {
      "name": "Type, class, interface, struct — warn-yellow, bold to part it from functions",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "meta.type.annotation entity.name.type",
        "storage.type.annotation"
      ],
      "settings": { "foreground": "#e0b84c", "fontStyle": "bold" }
    },
    {
      "name": "Primitive type keywords — string, number, bool",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type"
      ],
      "settings": { "foreground": "#e0b84c" }
    },
    {
      "name": "Variable — plain text, because most identifiers are not special",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "meta.definition.variable entity.name.function"
      ],
      "settings": { "foreground": "#d7e0e7" }
    },
    {
      "name": "Parameter — italic, the one place italics mean 'passed in'",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "variable.other.parameter"
      ],
      "settings": { "foreground": "#d7e0e7", "fontStyle": "italic" }
    },
    {
      "name": "Property and object key — muted, so data structure reads as data",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "variable.other.member",
        "entity.name.label"
      ],
      "settings": { "foreground": "#71838f" }
    },
    {
      "name": "Built-in variable and global",
      "scope": [
        "support.variable",
        "support.variable.dom",
        "support.constant",
        "variable.language"
      ],
      "settings": { "foreground": "#f2a33c" }
    },
    {
      "name": "Decorator and annotation",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.annotation",
        "storage.type.annotation.java"
      ],
      "settings": { "foreground": "#f2a33c", "fontStyle": "italic" }
    },
    {
      "name": "Module, import path",
      "scope": [
        "entity.name.import",
        "entity.name.module",
        "support.module",
        "meta.import string",
        "meta.export string"
      ],
      "settings": { "foreground": "#57c78a" }
    },

    {
      "name": "HTML/JSX tag — amber, the element is the keyword of markup",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag",
        "meta.tag punctuation.definition.tag"
      ],
      "settings": { "foreground": "#f2a33c" }
    },
    {
      "name": "HTML/JSX attribute name",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": { "foreground": "#e0b84c" }
    },
    {
      "name": "CSS selector — class, id, element",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "meta.selector",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": { "foreground": "#e0b84c" }
    },
    {
      "name": "CSS property name",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name"
      ],
      "settings": { "foreground": "#71838f" }
    },
    {
      "name": "CSS custom property — a machine-owned name, so amber",
      "scope": [
        "variable.css",
        "variable.argument.css",
        "support.type.custom-property-name"
      ],
      "settings": { "foreground": "#f2a33c" }
    },
    {
      "name": "At-rule",
      "scope": [
        "keyword.control.at-rule",
        "punctuation.definition.keyword.css"
      ],
      "settings": { "foreground": "#f2a33c" }
    },

    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json support.type.property-name"
      ],
      "settings": { "foreground": "#d7e0e7" }
    },
    {
      "name": "YAML / TOML / INI key",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.toml",
        "keyword.other.definition.ini",
        "entity.name.tag.ini"
      ],
      "settings": { "foreground": "#d7e0e7" }
    },

    {
      "name": "Markdown heading — amber, the display voice",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading"
      ],
      "settings": { "foreground": "#f2a33c", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "settings": { "foreground": "#d7e0e7", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "settings": { "foreground": "#d7e0e7", "fontStyle": "italic" }
    },
    {
      "name": "Markdown strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "foreground": "#55666f", "fontStyle": "strikethrough" }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "markup.underline.link.image",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": { "foreground": "#e0b84c", "fontStyle": "underline" }
    },
    {
      "name": "Markdown inline code and fenced block",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw.block",
        "punctuation.definition.raw"
      ],
      "settings": { "foreground": "#57c78a" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote", "punctuation.definition.quote"],
      "settings": { "foreground": "#71838f", "fontStyle": "italic" }
    },
    {
      "name": "Markdown list bullet",
      "scope": [
        "punctuation.definition.list",
        "markup.list punctuation.definition.list.begin"
      ],
      "settings": { "foreground": "#f2a33c" }
    },
    {
      "name": "Markdown separator and table pipes",
      "scope": ["meta.separator", "markup.table", "punctuation.separator.table"],
      "settings": { "foreground": "#1e2a33" }
    },

    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "punctuation.definition.inserted"],
      "settings": { "foreground": "#57c78a" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "punctuation.definition.deleted"],
      "settings": { "foreground": "#e05f5f" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": { "foreground": "#e0b84c" }
    },

    {
      "name": "Shell — the prompt and builtins",
      "scope": [
        "source.shell support.function.builtin",
        "source.shell keyword.command",
        "entity.name.command"
      ],
      "settings": { "foreground": "#e0b84c" }
    },
    {
      "name": "Shell variable",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": { "foreground": "#f2a33c" }
    },

    {
      "name": "Elixir atom, sigil and module attribute",
      "scope": [
        "constant.other.symbol.elixir",
        "constant.other.keywords.elixir",
        "variable.other.readwrite.module.elixir",
        "punctuation.definition.constant.elixir"
      ],
      "settings": { "foreground": "#f2a33c" }
    },

    {
      "name": "Invalid — the only place danger-red appears in code",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#e05f5f", "fontStyle": "bold" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#e0b84c", "fontStyle": "strikethrough" }
    }
  ],

  "semanticTokenColors": {
    "parameter": { "foreground": "#d7e0e7", "fontStyle": "italic" },
    "property": { "foreground": "#71838f" },
    "property.declaration": { "foreground": "#71838f" },
    "variable.readonly": { "foreground": "#f2a33c" },
    "variable.defaultLibrary": { "foreground": "#f2a33c" },
    "function.defaultLibrary": { "foreground": "#e0b84c" },
    "class": { "foreground": "#e0b84c", "fontStyle": "bold" },
    "interface": { "foreground": "#e0b84c", "fontStyle": "bold" },
    "enum": { "foreground": "#e0b84c", "fontStyle": "bold" },
    "enumMember": { "foreground": "#f2a33c" },
    "type": { "foreground": "#e0b84c" },
    "typeParameter": { "foreground": "#e0b84c", "fontStyle": "italic" },
    "namespace": { "foreground": "#d7e0e7" },
    "decorator": { "foreground": "#f2a33c", "fontStyle": "italic" },
    "selfParameter": { "foreground": "#f2a33c" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
