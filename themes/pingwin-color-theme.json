{
  "$schema": "vscode://schemas/color-theme",
  "name": "Pingwin",
  "type": "dark",
  "semanticHighlighting": true,

  // Pingwin's transmission-console palette, ported to VS Code.
  //
  // Elevation is four steps, and every surface picks exactly one of them:
  //   #0b1014  ink         chrome — activity bar, side bar, status bar, title bar
  //   #10171d  ink-raise   the panel you work in — editor, active tab, terminal
  //   #19232c  panel-high  things that float — suggest, hover, menus, notifications
  //   #080c0f  ink-press   recessed — inputs, dropdowns, peek editor, code blocks
  //
  // Amber #f2a33c is the only chrome accent, exactly as in pingwin: it marks the
  // active thing and nothing else. Green and red stay status semantics. Syntax is
  // drawn from amber / warn #e0b84c / ok #57c78a / danger #e05f5f and the grey ramp
  // #d7e0e7 - #71838f - #55666f, so every hex traces back to a real pingwin token.
  //
  // The ANSI terminal block is the one deliberate exception. Programs address those
  // sixteen slots by index, so blue, cyan and magenta have to exist or `ls`, npm and
  // git output lose meaning. They are derived desaturated and kept dim enough that
  // they never compete with amber.

  "colors": {
    // --- base ----------------------------------------------------------

    "foreground": "#d7e0e7",
    "descriptionForeground": "#71838f",
    "disabledForeground": "#55666f",
    "errorForeground": "#e05f5f",
    "focusBorder": "#f2a33c",
    "contrastBorder": "#1e2a33",
    "contrastActiveBorder": "#f2a33c",
    "widget.border": "#1e2a33",
    "widget.shadow": "#00000080",
    "selection.background": "#f2a33c47",
    "icon.foreground": "#71838f",
    "sash.hoverBorder": "#f2a33c",

    "textLink.foreground": "#f2a33c",
    "textLink.activeForeground": "#d88b25",
    "textPreformat.foreground": "#57c78a",
    "textBlockQuote.background": "#080c0f",
    "textBlockQuote.border": "#f2a33c",
    "textCodeBlock.background": "#080c0f",
    "textSeparator.foreground": "#1e2a33",

    // --- window chrome ------------------------------------------------

    "titleBar.activeBackground": "#0b1014",
    "titleBar.activeForeground": "#d7e0e7",
    "titleBar.inactiveBackground": "#0b1014",
    "titleBar.inactiveForeground": "#71838f",
    "titleBar.border": "#1e2a33",

    "menubar.selectionBackground": "#1e2a33",
    "menubar.selectionForeground": "#d7e0e7",
    "menubar.selectionBorder": "#00000000",
    "menu.background": "#19232c",
    "menu.foreground": "#d7e0e7",
    "menu.border": "#2c3d49",
    "menu.selectionBackground": "#1e2a33",
    "menu.selectionForeground": "#f2a33c",
    "menu.selectionBorder": "#00000000",
    "menu.separatorBackground": "#1e2a33",

    // --- activity bar: pingwin's left nav, 2px amber active border -----

    "activityBar.background": "#0b1014",
    "activityBar.foreground": "#d7e0e7",
    "activityBar.inactiveForeground": "#55666f",
    "activityBar.border": "#1e2a33",
    "activityBar.activeBorder": "#f2a33c",
    "activityBar.activeBackground": "#f2a33c14",
    "activityBar.activeFocusBorder": "#f2a33c",
    "activityBar.dropBorder": "#f2a33c",
    "activityBarBadge.background": "#f2a33c",
    "activityBarBadge.foreground": "#16110a",
